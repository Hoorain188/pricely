# Environment Variables Example Template
# Copy this file to .env and fill in your actual credentials.

# Neon PostgreSQL Database Connection String
NEON_DATABASE_URL="Host=YOUR_NEON_HOST.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;"
ConnectionStrings__DefaultConnection="Host=YOUR_NEON_HOST.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;"

# Local Backup Database
LOCAL_BACKUP_DATABASE_URL="Host=localhost;Port=5432;Database=pricely_db;Username=postgres;Password=YOUR_LOCAL_PASSWORD"

# Frontend Expo API Base URL
EXPO_PUBLIC_API_URL="http://10.0.2.2:5099"
