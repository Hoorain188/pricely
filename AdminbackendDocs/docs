openapi: 3.1.0
info:
  title: Pricely PK — Admin API
  version: 0.1.0
  description: >
    Contract for the Pricely admin panel, derived from the built React Native
    screens. Frozen before backend work starts. Any change here must be agreed
    with the mobile team first.

    OPEN QUESTIONS (resolve before implementing — marked TODO inline):
      1. "Saved by shoppers" formula is undefined.
      2. Scraper row button labelled "Unavailable" — actual behaviour unknown.
      3. Two-factor auth shown as ON in Settings — out of scope for v0.1.
      4. Activity log references an access-request flow that has no screen.

servers:
  - url: https://api.pricely.pk/api/v1
    description: Production
  - url: http://localhost:5117/api/v1
    description: Local development

tags:
  - name: auth
  - name: dashboard
  - name: duplicates
  - name: users
  - name: team
  - name: reports
  - name: settings

security:
  - bearerAuth: []

paths:

  # ----------------------------------------------------------------- auth

  /auth/login:
    post:
      tags: [auth]
      summary: Sign in (customers and admin team share this endpoint)
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [email, password]
              properties:
                email: { type: string, format: email }
                password: { type: string, minLength: 8 }
      responses:
        '200':
          description: Signed in
          content:
            application/json:
              schema: { $ref: '#/components/schemas/AuthTokens' }
        '401': { $ref: '#/components/responses/Unauthorized' }
        '423':
          description: Account locked after repeated failed attempts

  /auth/refresh:
    post:
      tags: [auth]
      summary: Exchange a refresh token for a new access token
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [refreshToken]
              properties:
                refreshToken: { type: string }
      responses:
        '200':
          content:
            application/json:
              schema: { $ref: '#/components/schemas/AuthTokens' }
        '401': { $ref: '#/components/responses/Unauthorized' }

  /auth/accept-invite:
    post:
      tags: [auth]
      summary: Set password from an emailed invite link
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [token, password]
              properties:
                token: { type: string }
                password: { type: string, minLength: 8 }
      responses:
        '200':
          content:
            application/json:
              schema: { $ref: '#/components/schemas/AuthTokens' }
        '400':
          description: Token invalid, already used, or expired

  /auth/me:
    get:
      tags: [auth]
      summary: Current signed-in user (drives the Settings header)
      responses:
        '200':
          content:
            application/json:
              schema: { $ref: '#/components/schemas/TeamMember' }

  /auth/sessions:
    get:
      tags: [auth]
      summary: Devices signed in to this account
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items: { $ref: '#/components/schemas/Session' }

  /auth/sessions/{sessionId}:
    delete:
      tags: [auth]
      summary: Revoke one session
      parameters:
        - { name: sessionId, in: path, required: true, schema: { type: string, format: uuid } }
      responses:
        '204': { description: Revoked }

  # ------------------------------------------------------------ dashboard

  /admin/dashboard:
    get:
      tags: [dashboard]
      summary: Everything on the dashboard screen in one call
      description: >
        Single call by design — the screen renders as one scroll, so six
        round-trips would make it feel slow. All three roles may read this.
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                required: [kpis, scrapers, topSearches, mostTracked, storeClicks, recentErrors]
                properties:
                  greetingName:
                    type: string
                    example: Bilal
                  lastUpdatedAt: { type: string, format: date-time }
                  kpis:
                    type: object
                    properties:
                      totalUsers: { $ref: '#/components/schemas/KpiValue' }
                      productsTracked: { $ref: '#/components/schemas/KpiValue' }
                      activeAlerts: { $ref: '#/components/schemas/KpiValue' }
                      scrapersHealthy: { type: integer, example: 3 }
                      scrapersTotal: { type: integer, example: 4 }
                  scrapers:
                    type: array
                    items: { $ref: '#/components/schemas/ScraperStatus' }
                  topSearches:
                    type: array
                    items: { $ref: '#/components/schemas/RankedItem' }
                  mostTracked:
                    type: array
                    items: { $ref: '#/components/schemas/RankedItem' }
                  storeClicks:
                    type: array
                    items: { $ref: '#/components/schemas/RankedItem' }
                  recentErrors:
                    type: array
                    items: { $ref: '#/components/schemas/ScraperError' }

  /admin/scrapers/{storeId}/run:
    post:
      tags: [dashboard]
      summary: Trigger a scrape run now
      description: >
        TODO — confirm this is what the row button does. The UI currently
        labels it "Unavailable" on every row, which looks like a placeholder.
        Admin and Support only. Returns 202; the run is queued, not immediate.
      parameters:
        - { name: storeId, in: path, required: true, schema: { type: string, example: daraz } }
      responses:
        '202':
          description: Run queued
          content:
            application/json:
              schema:
                type: object
                properties:
                  jobId: { type: string, format: uuid }
        '403': { $ref: '#/components/responses/Forbidden' }
        '409':
          description: A run for this store is already in progress

  # ----------------------------------------------------------- duplicates

  /admin/duplicates:
    get:
      tags: [duplicates]
      summary: Duplicate candidate groups
      parameters:
        - name: status
          in: query
          required: true
          schema: { type: string, enum: [pending, merged] }
        - { name: q, in: query, schema: { type: string } }
        - { name: page, in: query, schema: { type: integer, default: 1, minimum: 1 } }
        - { name: pageSize, in: query, schema: { type: integer, default: 20, maximum: 100 } }
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                properties:
                  pendingCount: { type: integer, description: Drives the "Needs review · 5" tab }
                  mergedCount: { type: integer, description: Drives the "Merged · 3" tab }
                  items:
                    type: array
                    items: { $ref: '#/components/schemas/DuplicateGroup' }
                  page: { type: integer }
                  totalPages: { type: integer }

  /admin/duplicates/{groupId}/merge:
    post:
      tags: [duplicates]
      summary: Merge the selected listings into one product
      description: Admin and Support only.
      parameters:
        - { name: groupId, in: path, required: true, schema: { type: string, format: uuid } }
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [listingIds]
              properties:
                listingIds:
                  type: array
                  minItems: 2
                  items: { type: string, format: uuid }
      responses:
        '200':
          description: Merged. Returns fresh counts so the tabs update without a refetch.
          content:
            application/json:
              schema:
                type: object
                properties:
                  productId: { type: string, format: uuid }
                  pendingCount: { type: integer }
                  mergedCount: { type: integer }
        '403': { $ref: '#/components/responses/Forbidden' }
        '409':
          description: Group already actioned by someone else

  /admin/duplicates/{groupId}/reject:
    post:
      tags: [duplicates]
      summary: Mark a group as "Not a match"
      parameters:
        - { name: groupId, in: path, required: true, schema: { type: string, format: uuid } }
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                properties:
                  pendingCount: { type: integer }
                  mergedCount: { type: integer }
        '403': { $ref: '#/components/responses/Forbidden' }

  /admin/products/{productId}/split:
    post:
      tags: [duplicates]
      summary: Split a merged product back into separate listings
      description: Seen in the activity log. Admin and Support only.
      parameters:
        - { name: productId, in: path, required: true, schema: { type: string, format: uuid } }
      responses:
        '200': { description: Split }
        '403': { $ref: '#/components/responses/Forbidden' }

  # ---------------------------------------------------------------- users

  /admin/customers:
    get:
      tags: [users]
      summary: App users (the Customers tab)
      parameters:
        - { name: q, in: query, schema: { type: string } }
        - { name: page, in: query, schema: { type: integer, default: 1 } }
        - { name: pageSize, in: query, schema: { type: integer, default: 25, maximum: 100 } }
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                properties:
                  totalCount: { type: integer, description: Drives "Customers · 1,236" }
                  items:
                    type: array
                    items: { $ref: '#/components/schemas/Customer' }
                  page: { type: integer }
                  totalPages: { type: integer }

  /admin/customers/export:
    get:
      tags: [users]
      summary: Export customers as CSV
      responses:
        '200':
          description: CSV file
          content:
            text/csv:
              schema: { type: string }

  /admin/customers/{userId}/ban:
    post:
      tags: [users]
      summary: Ban a customer
      description: Admin only.
      parameters:
        - { name: userId, in: path, required: true, schema: { type: string, format: uuid } }
      responses:
        '204': { description: Banned }
        '403': { $ref: '#/components/responses/Forbidden' }

  # ----------------------------------------------------------------- team

  /admin/team:
    get:
      tags: [team]
      summary: Admin team members (the Team tab and Manage team access screen)
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                properties:
                  totalCount: { type: integer, description: Drives "Team · 4" }
                  items:
                    type: array
                    items: { $ref: '#/components/schemas/TeamMember' }

  /admin/team/invites:
    post:
      tags: [team]
      summary: Invite a team member by email
      description: Admin only. Sends an email with a set-password link.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [email, role]
              properties:
                email: { type: string, format: email }
                role: { $ref: '#/components/schemas/Role' }
      responses:
        '201':
          content:
            application/json:
              schema:
                type: object
                properties:
                  inviteId: { type: string, format: uuid }
                  email: { type: string }
                  role: { $ref: '#/components/schemas/Role' }
                  expiresAt: { type: string, format: date-time }
        '403': { $ref: '#/components/responses/Forbidden' }
        '409':
          description: Email already on the team or already invited

  /admin/team/{userId}/role:
    patch:
      tags: [team]
      summary: Change a member's role
      description: >
        Admin only. Rejected if it would remove the last Admin, or if the
        caller is changing their own role.
      parameters:
        - { name: userId, in: path, required: true, schema: { type: string, format: uuid } }
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [role]
              properties:
                role: { $ref: '#/components/schemas/Role' }
      responses:
        '200':
          content:
            application/json:
              schema: { $ref: '#/components/schemas/TeamMember' }
        '403': { $ref: '#/components/responses/Forbidden' }
        '422':
          description: Would leave no Admin, or caller is modifying self
          content:
            application/json:
              schema: { $ref: '#/components/schemas/Problem' }

  /admin/team/{userId}:
    delete:
      tags: [team]
      summary: Remove a member from the team
      description: >
        Admin only. Same guards as role change — cannot remove the last Admin,
        cannot remove yourself. The demo activity log shows "Removed Bilal from
        the team" performed by Bilal; the backend must make that impossible.
      parameters:
        - { name: userId, in: path, required: true, schema: { type: string, format: uuid } }
      responses:
        '204': { description: Removed }
        '403': { $ref: '#/components/responses/Forbidden' }
        '422':
          description: Would leave no Admin, or caller is removing self
          content:
            application/json:
              schema: { $ref: '#/components/schemas/Problem' }

  # -------------------------------------------------------------- reports

  /admin/reports:
    get:
      tags: [reports]
      summary: Reports screen
      parameters:
        - name: period
          in: query
          required: true
          schema: { type: string, enum: [weekly, monthly, yearly] }
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                properties:
                  period: { type: string }
                  activeShoppers: { $ref: '#/components/schemas/KpiValue' }
                  savedByShoppers:
                    type: object
                    description: >
                      TODO — formula undefined. Candidate definition: sum over
                      click-throughs of (median offer price - clicked offer
                      price), counted only where 2+ offers existed at click
                      time. Agree this before implementing; the number is
                      meaningless otherwise.
                    properties:
                      amount: { type: number, example: 2100000 }
                      currency: { type: string, example: PKR }
                  trendingSearches:
                    type: array
                    items: { $ref: '#/components/schemas/RankedItem' }

  /admin/activity:
    get:
      tags: [reports]
      summary: Activity log — who did what across the admin team
      parameters:
        - { name: page, in: query, schema: { type: integer, default: 1 } }
        - { name: pageSize, in: query, schema: { type: integer, default: 30 } }
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                properties:
                  items:
                    type: array
                    items: { $ref: '#/components/schemas/ActivityEntry' }
                  page: { type: integer }
                  totalPages: { type: integer }

  # ------------------------------------------------------------- settings

  /admin/me/notifications:
    get:
      tags: [settings]
      summary: Notification toggles for the current user
      responses:
        '200':
          content:
            application/json:
              schema: { $ref: '#/components/schemas/NotificationPrefs' }
    patch:
      tags: [settings]
      summary: Update notification toggles
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/NotificationPrefs' }
      responses:
        '200':
          content:
            application/json:
              schema: { $ref: '#/components/schemas/NotificationPrefs' }

components:

  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  responses:
    Unauthorized:
      description: Missing, expired, or invalid token
      content:
        application/problem+json:
          schema: { $ref: '#/components/schemas/Problem' }
    Forbidden:
      description: Signed in, but this role may not perform the action
      content:
        application/problem+json:
          schema: { $ref: '#/components/schemas/Problem' }

  schemas:

    Role:
      type: string
      enum: [Admin, Support, ReadOnly]
      description: >
        Admin — full access including settings, team management, merge/split.
        Support — day-to-day work: merge/split, re-run scrapers, view users.
        ReadOnly — dashboard and reports only.

    AuthTokens:
      type: object
      required: [accessToken, refreshToken, expiresIn, user]
      properties:
        accessToken: { type: string }
        refreshToken: { type: string }
        expiresIn: { type: integer, description: Access token lifetime in seconds }
        user: { $ref: '#/components/schemas/TeamMember' }

    TeamMember:
      type: object
      required: [id, name, email, role]
      properties:
        id: { type: string, format: uuid }
        name: { type: string, example: H. Tariq }
        email: { type: string, format: email }
        role: { $ref: '#/components/schemas/Role' }
        jobTitle:
          type: string
          nullable: true
          example: Ops & Catalog
          description: The muted text after the email. May be null (see Zainab in the mock).
        avatarInitial: { type: string, maxLength: 2, example: B }

    Customer:
      type: object
      required: [id, name, email, alertCount]
      properties:
        id: { type: string, format: uuid }
        name: { type: string }
        email: { type: string, format: email }
        alertCount: { type: integer, example: 3 }
        isBanned: { type: boolean, default: false }

    KpiValue:
      type: object
      required: [value]
      properties:
        value: { type: integer, example: 1240 }
        changePercent:
          type: number
          nullable: true
          example: 8
          description: Positive or negative; null when there is no prior period to compare.

    ScraperStatus:
      type: object
      required: [storeId, storeName, status, lastRunAt, itemCount]
      properties:
        storeId: { type: string, example: daraz }
        storeName: { type: string, example: Daraz }
        status: { type: string, enum: [ok, fail, running] }
        lastRunAt: { type: string, format: date-time }
        itemCount: { type: integer, example: 4820 }
        canRun:
          type: boolean
          description: >
            False when a run is already in progress, or when the caller is
            ReadOnly. The UI greys the button when false.

    ScraperError:
      type: object
      properties:
        storeName: { type: string, example: Telemart }
        message: { type: string, example: timeout after 30s }
        occurredAt: { type: string, format: date-time }

    RankedItem:
      type: object
      required: [label, count]
      properties:
        label: { type: string, example: iPhone 15 }
        count: { type: integer, example: 2340 }

    DuplicateGroup:
      type: object
      required: [id, title, matchScore, listings]
      properties:
        id: { type: string, format: uuid }
        title: { type: string, example: iPhone 15 Pro 256GB }
        matchScore:
          type: integer
          minimum: 0
          maximum: 100
          example: 92
        listings:
          type: array
          items: { $ref: '#/components/schemas/Listing' }

    Listing:
      type: object
      required: [id, title, storeName, price, currency]
      properties:
        id: { type: string, format: uuid }
        title: { type: string, example: iPhone 15 Pro 256GB Black }
        storeName: { type: string, example: Daraz }
        price: { type: number, example: 385000 }
        currency: { type: string, example: PKR }
        preSelected:
          type: boolean
          description: >
            Whether the checkbox starts ticked. In the mock the two highest
            scoring listings are pre-ticked and the third is not.

    Session:
      type: object
      required: [id, deviceLabel, lastActiveAt, isCurrent]
      properties:
        id: { type: string, format: uuid }
        deviceLabel: { type: string, example: iPhone 15 · Expo Go }
        deviceType: { type: string, enum: [mobile, desktop, unknown] }
        location:
          type: string
          nullable: true
          example: Lahore, PK
          description: >
            Requires storing IP per refresh token plus a GeoIP lookup.
            Recommend shipping v0.1 with this null and the UI hiding it.
        lastActiveAt: { type: string, format: date-time }
        isCurrent: { type: boolean }

    ActivityEntry:
      type: object
      required: [id, description, actorName, occurredAt]
      properties:
        id: { type: string, format: uuid }
        description:
          type: string
          example: Changed Ayesha's role to Support
          description: >
            Server-rendered sentence. Keeping the wording on the server means
            new action types do not require a mobile release.
        actorName: { type: string, example: Bilal }
        occurredAt: { type: string, format: date-time }

    NotificationPrefs:
      type: object
      properties:
        newReports: { type: boolean }
        syncFailures: { type: boolean }
        weeklySummaryEmail: { type: boolean }

    Problem:
      type: object
      description: RFC 9457 problem details — the standard ASP.NET Core error shape.
      properties:
        type: { type: string }
        title: { type: string, example: Cannot remove the last admin }
        status: { type: integer, example: 422 }
        detail: { type: string }
        errors:
          type: object
          additionalProperties:
            type: array
            items: { type: string }