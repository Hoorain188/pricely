<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>4ced2916-0855-434d-8b6f-83dee6344b67</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Admin side -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />

    <!-- Auth side. Npgsql is not listed here: it arrives through
         Pricely.Infrastructure, which owns the DbContext.
         EFCore.NamingConventions is deliberately dropped too — AppDbContext
         already does its own PascalCase→snake_case pass, and running both
         would translate names twice. -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.3" />

    <!-- Scrapers (moved from PriceCompare.Api) -->
    <PackageReference Include="AngleSharp" Version="1.7.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pricely.Core\Pricely.Core.csproj" />
    <ProjectReference Include="..\Pricely.Infrastructure\Pricely.Infrastructure.csproj" />
  </ItemGroup>

</Project>
